POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

SECRET_KEY=
ALGORITHM=HS256 #algoritmo de cifrado
ACCESS_TOKEN_EXPIRE_MINUTES=

#variable para docker
POSTGRES_HOST=

# Ruta local de PDFs de factura (en Docker Compose se monta en /data/facturas)
FACTURAS_STORAGE_PATH=/data/facturas

# Ruta local de actas de entrega PDF/imagen (en Docker Compose se monta en /data/actas)
ACTAS_STORAGE_PATH=/data/actas

# Usuario administrador inicial (email de login). Se crea al arrancar si no existe.
ADMIN_USER=admin@empresa.cl
ADMIN_PASSWORD=
